{
  "name": "yt-captions-mini-ai",
  "version": "0.2.0",
  "description": "Blazing-fast YouTube-only captions CLI (ytcap) with bulk concurrency, disk cache, and optional local-agent SKILL.md scaffolding",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "Yosef Hayim Sabag",
  "homepage": "https://github.com/YosefHayim/yt-captions-mini-ai",
  "bugs": {
    "url": "https://github.com/YosefHayim/yt-captions-mini-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YosefHayim/yt-captions-mini-ai.git"
  },
  "keywords": [
    "youtube",
    "captions",
    "transcript",
    "subtitles",
    "cli",
    "ytcap",
    "innertube",
    "playlist",
    "channel",
    "agent-skills",
    "typescript"
  ],
  "main": "dist/main.js",
  "bin": {
    "ytcap": "dist/main.js",
    "yt-captions-mini-ai": "dist/main.js"
  },
  "exports": {
    ".": "./dist/main.js"
  },
  "files": [
    "dist",
    "config",
    "llms.txt",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json && node scripts/ensure-bin-shebang.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build",
    "canary": "node dist/main.js url=https://www.youtube.com/watch?v=dQw4w9WgXcQ lang=en auto output-format=txt out-dir=./scraped-yt-canary concurrency=1 no-cache"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "effect": "^3.22.1",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2"
  }
}
