{
  "name": "yt-captions-mini-ai",
  "version": "0.1.0",
  "description": "A tiny TypeScript CLI for extracting YouTube captions and optional local agent conversion",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "Yosef Hayim Sabag",
  "homepage": "https://github.com/YosefHayim/yt-captions-mini-ai",
  "bugs": {
    "url": "https://github.com/YosefHayim/yt-captions-mini-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YosefHayim/yt-captions-mini-ai.git"
  },
  "keywords": [
    "youtube",
    "captions",
    "transcript",
    "playlist",
    "cli",
    "typescript"
  ],
  "main": "dist/main.js",
  "bin": {
    "yt-captions-mini-ai": "dist/main.js"
  },
  "exports": {
    ".": "./dist/main.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "start:dist": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "effect": "^3.22.1",
    "@clack/prompts": "^0.11.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2"
  }
}
